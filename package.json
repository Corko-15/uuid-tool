{
    "name": "uuid-tool",
    "version": "1.0.1",
    "license": "MIT",
    "description": "Small UUID generator desktop widget",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "licenses": "license-checker-rseidelsohn --out THIRD_PARTY_NOTICES.txt",
        "build": "npm run licenses && electron-builder"
    },
    "devDependencies": {
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3",
        "license-checker-rseidelsohn": "^5.0.1"
    },
    "build": {
        "appId": "com.uuidtool.app",
        "productName": "UUID Tool",
        "win": {
            "icon": "icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "mac": {
            "icon": "icon.icns",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.utilities"
        },
        "linux": {
            "icon": "icons",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Utility"
        }
    }
}
