{
    "name": "uuid-tool",
    "version": "1.0.0",
    "description": "Small UUID generator desktop widget",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "prebuild": "license-checker-rseidelsohn --production --out THIRD_PARTY_NOTICES.txt",
        "build": "electron-builder"
    },
    "devDependencies": {
        "electron": "^37.10.3",
        "electron-builder": "^26.15.3",
        "license-checker-rseidelsohn": "^5.0.1"
    },
    "build": {
        "appId": "com.uuidtool.app",
        "productName": "UUID Tool",
        "extraResources": [
            {
                "from": "THIRD_PARTY_NOTICES.txt",
                "to": "THIRD_PARTY_NOTICES.txt"
            }
        ],
        "win": {
            "icon": "icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "license": "THIRD_PARTY_NOTICES.txt"
        },
        "mac": {
            "icon": "icon.icns",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.utilities",
            "license": "THIRD_PARTY_NOTICES.txt"
        },
        "linux": {
            "icon": "icons",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Utility"
        }
    }
}
